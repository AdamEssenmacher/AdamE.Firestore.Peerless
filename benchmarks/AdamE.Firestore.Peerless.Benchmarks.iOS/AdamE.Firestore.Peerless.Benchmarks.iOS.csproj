<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdamE.Firestore.Peerless.Benchmarks</RootNamespace>
    <ApplicationId>com.adame.firestore.peerless.benchmarks</ApplicationId>
    <ApplicationTitle>Peerless Bench</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>

    <!-- The point of step 4: the ordinary peered binding under full NativeAOT. -->
    <PublishAot>true</PublishAot>
    <!-- The iOS SDK applies PublishAot only while publishing (_UseNativeAot needs _IsPublishing), and `dotnet publish`
         refuses simulator RIDs. Claiming to publish makes `dotnet build` produce the NativeAOT app for the simulator.
         The app records RuntimeFeature.IsDynamicCodeSupported at startup to prove it. -->
    <_IsPublishing>true</_IsPublishing>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform-neutral half of the benchmark, shared with Android: seeded documents, plain output model, phases
         and settle points. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdamE.Firebase.iOS.CloudFirestore" />
  </ItemGroup>
</Project>
