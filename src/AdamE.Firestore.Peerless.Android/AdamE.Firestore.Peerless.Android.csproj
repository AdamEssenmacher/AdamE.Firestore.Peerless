<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RootNamespace>AdamE.Firestore.Peerless.Android</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated binding code lacks XML docs; everything it produces is internal anyway. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Listens to Firestore on Android through a small Java shim that encodes each snapshot once, so no Firestore value crosses into .NET as a peer object.</Description>

    <PeerlessShimDirectory>$(MSBuildThisFileDirectory)../../android/</PeerlessShimDirectory>
    <PeerlessShimAar>$(PeerlessShimDirectory)peerless-shim/build/outputs/aar/peerless-shim-release.aar</PeerlessShimAar>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Firebase.Firestore" />
    <ProjectReference Include="../AdamE.Firestore.Peerless/AdamE.Firestore.Peerless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(PeerlessShimAar)" />
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Benchmarks.Android" />
  </ItemGroup>

  <!-- Builds the Java shim with Gradle when its sources or Gradle configuration are newer than the AAR. A packaged
       build will ship the AAR. It runs before _CategorizeAndroidLibraries, the first target that reads the AAR, so the
       same build binds and packages the rebuilt one. -->
  <ItemGroup>
    <PeerlessShimSource Include="$(PeerlessShimDirectory)peerless-shim/src/main/**/*" />
    <PeerlessShimSource Include="$(PeerlessShimDirectory)peerless-shim/*.gradle.kts;$(PeerlessShimDirectory)peerless-shim/*.pro" />
    <PeerlessShimSource Include="$(PeerlessShimDirectory)*.gradle.kts;$(PeerlessShimDirectory)gradle.properties" />
    <PeerlessShimSource Include="$(PeerlessShimDirectory)gradle/**/*.properties;$(PeerlessShimDirectory)gradle/**/*.toml" />
  </ItemGroup>
  <PropertyGroup>
    <PeerlessGradle Condition="'$(OS)' == 'Windows_NT'">gradlew.bat</PeerlessGradle>
    <PeerlessGradle Condition="'$(OS)' != 'Windows_NT'">./gradlew</PeerlessGradle>
  </PropertyGroup>
  <Target Name="BuildPeerlessShim"
          BeforeTargets="_CategorizeAndroidLibraries;PrepareForBuild;_ResolveLibraryProjectImports;ResolveAssemblyReferences"
          Inputs="@(PeerlessShimSource)" Outputs="$(PeerlessShimAar)">
    <Exec Command="$(PeerlessGradle) :peerless-shim:assembleRelease --console=plain -q" WorkingDirectory="$(PeerlessShimDirectory)" />
  </Target>
</Project>
