<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdamE.Firestore.Peerless</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Decodes Firestore snapshots, encoded once by a native shim, into plain .NET values without per-value peer objects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Tests" />
    <!-- The peered baseline builds the same value model through the owning constructors, so only transport differs. -->
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Benchmarks.Android" />
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Benchmarks.iOS" />
  </ItemGroup>
</Project>
