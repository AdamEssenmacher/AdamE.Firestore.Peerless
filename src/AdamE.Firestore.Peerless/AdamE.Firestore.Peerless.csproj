<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdamE.Firestore.Peerless</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Decodes Firestore snapshots, encoded once by a native shim, into plain .NET values without per-value peer objects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Tests" />
    <!-- The decode benchmark builds frames with the tests' spec-derived encoder, which uses the wire constants. -->
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Benchmarks.Decoder" />
    <!-- The benchmark's equality check builds this value model from the peered binding (PeeredConversion), through the
         owning constructors, to compare it with what Peerless decodes. -->
    <InternalsVisibleTo Include="AdamE.Firestore.Peerless.Benchmarks.Android" />
  </ItemGroup>
</Project>
