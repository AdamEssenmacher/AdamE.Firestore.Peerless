<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs managed tests against the real iOS receiver (FrameReceiver, its native entry points, GCD) on a simulator:
       scripts/test-ios-managed.sh builds, installs and launches it and reads its MANAGED_TESTS line. No Firebase app
       is configured and no backend is needed: the tests call the receiver as the shim would. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdamE.Firestore.Peerless.Tests.iOS</RootNamespace>
    <ApplicationId>com.adame.firestore.peerless.tests</ApplicationId>
    <ApplicationTitle>Peerless Tests</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Mono, not NativeAOT: it builds in a fraction of the time, and what these tests pin (the gate, GCD hops, the
         [UnmanagedCallersOnly] entries) doesn't depend on the runtime. The benchmark app covers NativeAOT. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- A golden frame for the frame-path tests, read with GetManifestResourceStream. -->
    <EmbeddedResource Include="../../fixtures/wire/document-scalars.bin" LogicalName="document-scalars.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdamE.Firebase.iOS.CloudFirestore" />
    <ProjectReference Include="../../src/AdamE.Firestore.Peerless.iOS/AdamE.Firestore.Peerless.iOS.csproj" />
  </ItemGroup>
</Project>
