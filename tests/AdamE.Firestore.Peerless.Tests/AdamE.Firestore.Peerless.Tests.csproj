<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdamE.Firestore.Peerless.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Golden fixtures shared with the native encoders' tests. -->
    <FixturesDirectory>$(MSBuildThisFileDirectory)../../fixtures/wire/</FixturesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdamE.Firestore.Peerless/AdamE.Firestore.Peerless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="AdamE.Firestore.Peerless.Tests.FixturesDirectoryAttribute">
      <_Parameter1>$(FixturesDirectory)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
