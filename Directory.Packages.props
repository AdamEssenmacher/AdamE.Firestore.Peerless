<Project>
  <ItemGroup>
    <!-- The ordinary, peered bindings that the benchmarks measure against. -->
    <!-- Bounded below the next major: the Android shim is compiled against the Firestore 26 inside this binding
         (compileOnly), so the package must not let an app restore Firestore 27 under it. Restore picks the lower
         bound. -->
    <PackageVersion Include="Xamarin.Firebase.Firestore" Version="[126.0.2.4,127)" />
    <PackageVersion Include="AdamE.Firebase.iOS.CloudFirestore" Version="12.18.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
